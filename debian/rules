#!/usr/bin/make -f
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The Blueberry Pie OS Authors

include /usr/share/pietoolchain/rules.mk

$(OBJ)/%.o: $(SRCROOT)/libexec/%.c
	@mkdir -p $(OBJ)
	$(CC) $(BASE_CFLAGS) -c $< -o $@

$(OBJ)/%: $(OBJ)/%.o
	$(CC) $(BASE_LDFLAGS) $< -o $@

install: $(OBJ)/pie-userreboot $(OBJ)/pie-mount $(OBJ)/pie-dpkg-lock $(OBJ)/pie-grow-partition
	install -d $(ROOT)/usr/sbin $(ROOT)/usr/libexec $(ROOT)/etc/dpkg/dpkg.cfg.d \
		$(ROOT)/etc/apt/apt.conf.d $(ROOT)/usr/lib/blueberry-pie-os/apt \
		$(ROOT)/usr/lib/blueberry-pie-os/data.d $(ROOT)/usr/local \
		$(ROOT)/System/Volumes/Update $(ROOT)/System/Volumes/Next \
		$(ROOT)/System/Volumes/Previous
	install -m 755 sbin/softreboot sbin/pie-seal sbin/pie-boot sbin/pie-data $(ROOT)/usr/sbin/
	ln -s pie-seal $(ROOT)/usr/sbin/pie-unseal
	ln -s ../libexec/pie-stage $(ROOT)/usr/sbin/pie-stage
	install -m 755 libexec/pie-root-setup libexec/pie-data-setup libexec/pie-stage \
		$(OBJ)/pie-userreboot $(OBJ)/pie-mount $(OBJ)/pie-dpkg-lock $(OBJ)/pie-grow-partition \
		$(ROOT)/usr/libexec/
	install -m 644 libexec/pie-zfsroot.sh $(ROOT)/usr/libexec/
	install -m 644 etc/dpkg/dpkg.cfg.d/pie-data $(ROOT)/etc/dpkg/dpkg.cfg.d/
	install -m 644 etc/apt/apt.conf.d/50pie-root $(ROOT)/etc/apt/apt.conf.d/
	install -D -m 755 debian/preinst $(ROOT)/DEBIAN/preinst

.PHONY: install
