#!/usr/bin/make -f
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The Blueberry Pie OS Authors

include /usr/share/pietoolchain/rules.mk

$(OBJ)/%.o: $(SRCROOT)/libexec/%.c
	@mkdir -p $(OBJ)
	$(CC) $(BASE_CFLAGS) -c $< -o $@

$(OBJ)/%: $(OBJ)/%.o
	$(CC) $(BASE_LDFLAGS) $< -o $@

install: check $(OBJ)/pie-userreboot $(OBJ)/pie-mount $(OBJ)/pie-dpkg-lock $(OBJ)/pie-grow-partition $(OBJ)/pie-data-directories
	install -d $(ROOT)/usr/sbin $(ROOT)/usr/libexec $(ROOT)/usr/lib/blueberry-pie-os/zfs \
		$(ROOT)/etc/apt/apt.conf.d $(ROOT)/usr/lib/blueberry-pie-os/apt \
		$(ROOT)/usr/lib/blueberry-pie-os/data.d $(ROOT)/usr/local \
		$(ROOT)/System/Volumes/Update $(ROOT)/System/Volumes/Next \
		$(ROOT)/System/Volumes/Previous
	install -m 755 sbin/softreboot sbin/pie-seal sbin/pie-boot sbin/pie-data $(ROOT)/usr/sbin/
	ln -s pie-seal $(ROOT)/usr/sbin/pie-unseal
	ln -s ../libexec/pie-stage $(ROOT)/usr/sbin/pie-stage
	install -m 755 libexec/pie-root-setup libexec/pie-data-setup libexec/pie-data-directory-legacy libexec/pie-stage \
		$(OBJ)/pie-userreboot $(OBJ)/pie-mount $(OBJ)/pie-dpkg-lock $(OBJ)/pie-grow-partition $(OBJ)/pie-data-directories \
		$(ROOT)/usr/libexec/
	install -m 644 libexec/pie-zfsroot.sh $(ROOT)/usr/libexec/
	install -m 644 lib/zfs/dpkg.cfg lib/zfs/apt.conf $(ROOT)/usr/lib/blueberry-pie-os/zfs/
	install -m 644 etc/apt/apt.conf.d/50pie-root $(ROOT)/etc/apt/apt.conf.d/
	install -D -m 755 debian/preinst $(ROOT)/DEBIAN/preinst
	install -m 755 debian/postinst debian/postrm $(ROOT)/DEBIAN/

check:
	@mkdir -p $(OBJ)
	/usr/bin/cc -std=c11 -O2 -Wall -Wextra -Werror '-DPIE_DATA_COMPAT="$(CURDIR)/libexec/pie-data-directory-legacy"' libexec/pie-data-directories.c -o $(OBJ)/host-data-directories
	sh tests/data-setup.sh .
	PIE_TEST_DIRECTORIES=$(OBJ)/host-data-directories sh tests/data-actions.sh .
	python3 tests/native-directories.py $(OBJ)/host-data-directories .
	/usr/bin/cc -std=c11 -O2 -Wall -Wextra -Werror '-DPIE_DATA_COMPAT="$(OBJ)/compat-recorder"' libexec/pie-data-directories.c -o $(OBJ)/dispatch-directories
	sh tests/id-dispatch.sh $(OBJ)/dispatch-directories $(OBJ)/compat-recorder
	sh tests/hfs-root.sh .

.PHONY: install check
