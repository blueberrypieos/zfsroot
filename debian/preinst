set -e
if [ "$1" = install ] && [ -z "${DPKG_ROOT:-}" ] &&
	! mount | awk '$3 == "/" && $4 == "(zfs," { found = 1 } END { exit !found }'; then
	echo "pie-zfsroot: the root is not a ZFS dataset; this package is for ZFS images" >&2
	exit 1
fi
