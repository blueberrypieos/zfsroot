set -e
zfs_root() {
	mount | awk -v t="${DPKG_ROOT:-/}" '$2 == "on" && $3 == t && $4 == "(zfs," { found = 1 } END { exit !found }'
}
put() {
	mkdir -p "${2%/*}"
	cp "$1" "$2.new"
	mv -f "$2.new" "$2"
}
case $1 in
configure)
	r=${DPKG_ROOT:-}
	if zfs_root; then
		put "$r/usr/lib/blueberry-pie-os/zfs/dpkg.cfg" "$r/etc/dpkg/dpkg.cfg.d/pie-zfs"
		put "$r/usr/lib/blueberry-pie-os/zfs/apt.conf" "$r/etc/apt/apt.conf.d/40pie-zfs"
	fi
	old=$r/etc/dpkg/dpkg.cfg.d/pie-data
	if [ -f "$old" ]; then
		if [ "$(sha256sum < "$old" | cut -d ' ' -f 1)" = 492079fab165176bdf657c11b87f3eecacff82e1508e46e309f85ec607ce6d34 ]; then
			rm -f "$old"
		else
			mv -f "$old" "$old.dpkg-bak"
		fi
	fi
	;;
esac
