#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The Blueberry Pie OS Authors
#
# usage: pie-root-setup boot|softboot
#        pie-root-setup rc STATUS boot|softboot
#
# init runs it before /etc/rc, and again once /etc/rc exits with STATUS
# (init gives a nonzero STATUS if this setup failed). Before /etc/rc it
# finishes the pool on its first boot, mounts the data set named by the
# pool's pie:data property (POOL/data/default if unset), makes the data
# set's directories with pie-data-setup and, on a sealed root, mounts the
# stage on /System/Volumes/Update. It also writes the dpkg and apt settings
# that only a ZFS root uses, /etc/dpkg/dpkg.cfg.d/pie-zfs and
# /etc/apt/apt.conf.d/40pie-zfs, into the root, or on a sealed root into
# the stage. A data set whose own mountpoint is not /private/var cannot
# be mounted. If the data set cannot be mounted, the one the last boot
# mounted, named by the pool's pie:lastdata, is mounted instead and
# becomes pie:data again. It exits nonzero if no data set can
# be mounted, or if the data set cannot be set up. After a soft reboot
# onto another root, STATUS 0 makes that root the pool's bootfs, with its
# kernel on the boot partition; any other status goes back to the bootfs
# with softreboot, or with a reboot if softreboot cannot run. At a reboot,
# if the boot partition may not hold the root's boot files, it updates the
# boot partition from the root once /etc/rc exits. It does not if the root
# is no longer the bootfs then. softreboot refuses until the next reboot.
# While apt or dpkg runs, the update is left to apt's post or the next
# reboot.

. /usr/libexec/pie-zfsroot.sh

root=$(root_ds)
[ -n "$root" ] || exit 0
pool=${root%%/*}

first_boot() {
	[ "$(pprop pie:setup "$pool")" = done ] && return 0
	ok=1
	if [ "$(pprop compatibility "$pool")" != openzfs-2.4 ]; then
		zpool set compatibility=openzfs-2.4 "$pool" || ok=
	fi
	zpool upgrade "$pool" > /dev/null || ok=
	zfs set compression=lz4 "$pool" && zfs set atime=off "$pool" || ok=
	list=$(zfs list -H -o name -r -t filesystem "$pool/root" "$pool/data") && [ -n "$list" ] || ok=
	for ds in $list; do
		case $ds in
		"$pool/root"|"$pool/data") ;;
		*) zfs set canmount=noauto "$ds" || ok= ;;
		esac
	done
	if v=$(prop pie:sealed "$root"); then
		[ "$v" = - ] && { zfs set pie:sealed=off "$root" || ok=; }
	else
		ok=
	fi
	if v=$(prop pie:kernelset "$root"); then
		if [ "$v" = - ]; then
			ks=$(kernelset /) && [ -n "$ks" ] && zfs set pie:kernelset="$ks" "$root" || ok=
		fi
	else
		ok=
	fi
	vdevs=$(zpool list -H -P -v -o name "$pool") || { vdevs=; ok=; }
	for vdev in $(printf '%s\n' "$vdevs" | awk 'NR == 1 { next } $1 == "cache" || $1 == "spare" { s = 1; next } $1 == "dedup" || $1 == "special" || $1 == "logs" { s = 0; next } !s && $1 ~ "^/dev/" { print $1 }'); do
		case $vdev in
		/dev/disk*s[1-4])
			/usr/libexec/pie-grow-partition "/dev/r$(basename "${vdev%s[1-4]}")" "${vdev##*s}"
			case $? in
			0|1) ;;
			*) ok=; continue ;;
			esac
			;;
		esac
		zpool online -e "$pool" "$vdev" || ok=
	done
	if [ -n "$ok" ]; then
		zpool set pie:setup=done "$pool"
	else
		echo "${0##*/}: the pool's first-boot setup failed; it is tried again at the next boot" >&2
	fi
}

unmount_data() {
	mount | awk -v d="$1" '$2 == "on" && ($1 == d || index($1, d "/") == 1) { print $3 }' | sort -r |
		while read -r m; do
			umount "$m" || exit 1
		done
}

repair() {
	zpool set pie:coldboot= "$pool"
	why="was being changed when the system stopped"
	! valid "$1" || why="held another root's boot files"
	ks=$2
	if ! sealed "$root" || ! valid "$ks"; then
		ks=$(kernelset /) && [ -n "$ks" ] && record "$root" "$ks" || ks=
	fi
	if valid "$ks" && boot_from "$pool" "" "$ks"; then
		echo "${0##*/}: the boot partition $why; it now holds $root's boot files; reboot to run its kernel" >&2
	else
		echo "${0##*/}: the boot partition $why, and cannot be updated from $root; the next boot tries again" >&2
	fi
}

ensure_stage() {
	stage=$(pprop pie:stage "$pool")
	if [ -n "$stage" ] && [ "$stage" != "$root" ] && exists "$stage" &&
		case $(prop origin "$stage") in "$root"@*) true ;; *) false ;; esac; then
		:
	else
		snap=$root@$(snapname stage)
		stage=$(next_root "$pool")
		zfs snapshot "$snap" && make_root "$snap" "$stage" on &&
			zpool set pie:stage="$stage" "$pool" || {
			echo "${0##*/}: cannot make a stage from $root" >&2
			return 1
		}
	fi
	mount_at "$stage" "$UPDATE"
}

case ${1:-} in
boot|softboot)
	first_boot
	data=$(pprop pie:data "$pool")
	[ -n "$data" ] || data=$pool/data/default
	if ! mount_data "$data" ""; then
		last=$(pprop pie:lastdata "$pool")
		if [ -z "$last" ] || [ "$last" = "$data" ]; then
			echo "${0##*/}: cannot mount the data set $data" >&2
			exit 1
		fi
		echo "${0##*/}: cannot mount the data set $data; going back to $last" >&2
		if ! unmount_data "$data" || ! mount_data "$last" ""; then
			echo "${0##*/}: cannot mount the data set $last" >&2
			exit 1
		fi
		data=$last
		zpool set pie:data="$data" "$pool" ||
			echo "${0##*/}: cannot make $data the pool's data set" >&2
	fi
	if [ "$(pprop pie:lastdata "$pool")" != "$data" ] && ! zpool set pie:lastdata="$data" "$pool"; then
		echo "${0##*/}: cannot record $data as the data set to go back to" >&2
	fi
	if ! sealed "$root"; then
		zfs_config "" || echo "${0##*/}: cannot write $root's dpkg and apt settings for a ZFS root" >&2
	fi
	/usr/libexec/pie-data-setup || exit 1
	if sealed "$root"; then
		if ensure_stage; then
			zfs_config "$UPDATE" ||
				echo "${0##*/}: cannot write the stage's dpkg and apt settings for a ZFS root" >&2
		fi
	fi
	if [ "$1" = boot ]; then
		ks=$(rootset "$root")
		if [ "$ks" = dirty ] && sealed "$root"; then
			ks=$(kernelset /) && [ -n "$ks" ] && record "$root" "$ks" || ks=dirty
		fi
		bk=$(pprop pie:bootkernel "$pool")
		if [ -z "$bk" ]; then
			bk=$ks
			zpool set pie:bootkernel="$bk" "$pool"
		fi
		if ! valid "$bk" || [ "$bk" != "$ks" ]; then
			zpool set pie:coldboot= "$pool"
			echo "${0##*/}: the boot partition may not hold $root's boot files; it is updated once /etc/rc exits" >&2
			exit 0
		fi
		bt=$(bootid)
		if [ -z "$bt" ] || ! zpool set pie:coldkernel="$bk" "$pool" ||
			! zpool set pie:coldboot="$bt" "$pool"; then
			zpool set pie:coldboot= "$pool"
			echo "${0##*/}: cannot record the running kernel; softreboot refuses until a reboot" >&2
			exit 1
		fi
	fi
	;;
rc)
	if [ "${3:-}" = boot ]; then
		bt=$(bootid)
		[ -z "$bt" ] || [ "$(pprop pie:coldboot "$pool")" != "$bt" ] || exit 0
		[ "$root" = "$(pprop bootfs "$pool")" ] || exit 0
		ks=$(rootset "$root")
		bk=$(pprop pie:bootkernel "$pool")
		if [ -n "$bk" ] && { ! valid "$bk" || [ "$bk" != "$ks" ]; }; then
			exclusive "$0" "$@"
			repair "$bk" "$ks"
		fi
		exit 0
	fi
	[ "${3:-}" = softboot ] || exit 0
	[ "${2:-}" = 0 ] && serialize "$0" "$@"
	bootfs=$(pprop bootfs "$pool")
	[ "$root" != "$bootfs" ] || exit 0
	if [ "${2:-}" = 0 ]; then
		ks=$(rootset "$root")
		if ! valid "$ks"; then
			echo "${0##*/}: $root's kernel set is not recorded; a reboot starts $bootfs" >&2
			exit 1
		fi
		if [ "$ks" != "$(pprop pie:bootkernel "$pool")" ] && ! boot_from "$pool" "" "$ks"; then
			echo "${0##*/}: cannot put $root's boot files on the boot partition; a reboot starts $bootfs" >&2
			exit 1
		fi
		zpool set bootfs="$root" "$pool" || exit 1
		[ "$(pprop pie:next "$pool")" = "$root" ] && zpool set pie:next= "$pool"
		echo "${0##*/}: $root is the root from now on"
	else
		echo "${0##*/}: the boot failed on $root; going back to $bootfs" >&2
		if [ -z "$bootfs" ] || ! /usr/sbin/softreboot -r "$bootfs"; then
			exec reboot
		fi
	fi
	;;
*)
	echo "usage: ${0##*/} boot|softboot | rc STATUS boot|softboot" >&2
	exit 2
	;;
esac
exit 0
