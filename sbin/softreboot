#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The Blueberry Pie OS Authors
#
# usage: softreboot [-r ROOT] [-d DATA]
#
# Restarts user space without restarting the kernel. On a ZFS root it can
# also switch the root to ROOT, by default the pool's pie:next (a staged,
# sealed, unsealed or rolled-back root) or else the running root, and the
# data set to POOL/data/DATA. A root whose kernel set differs from the
# running kernel's needs a reboot instead. A new root that fails to boot
# to the end of /etc/rc gives way to the pool's bootfs again. A data set
# that cannot be mounted gives way to the one that ran before.

. /usr/libexec/pie-zfsroot.sh

need_root
target= data=
while getopts r:d: opt; do
	case $opt in
	r) target=$OPTARG ;;
	d) data=$OPTARG ;;
	*) echo "usage: softreboot [-r ROOT] [-d DATA]" >&2; exit 2 ;;
	esac
done

root=$(root_ds)
if [ -z "$root" ]; then
	[ -z "$target$data" ] || die "-r and -d need a ZFS root"
	: > "$TARGET" || die "cannot write $TARGET"
	exec /usr/libexec/pie-userreboot
fi
exclusive "$0" "$@"
pool=${root%%/*}
[ -n "$target" ] || target=$(pprop pie:next "$pool")
[ -n "$target" ] || target=$root
case $target in
*/*) ;;
*) target=$pool/root/$target ;;
esac
case $target in
"$pool"/root/*) exists "$target" || die "no root $target" ;;
*) die "$target is not a root of $pool" ;;
esac
cold=$(coldkernel "$pool")
[ -n "$cold" ] || die "the running kernel is not recorded; reboot"
[ "$(prop pie:kernelset "$target")" = "$cold" ] ||
	die "$target has another kernel than the running one; make it the root with pie-boot set, then reboot"
if [ "$target" != "$root" ]; then
	if sealed "$target"; then
		zfs set readonly=on "$target"
	else
		zfs set readonly=off "$target"
	fi || die "cannot set $target's readonly property"
	if [ "$(pprop pie:stage "$pool")" = "$target" ]; then
		zpool set pie:stage= "$pool" || die "cannot clear the pool's stage"
	fi
fi
if [ -n "$data" ]; then
	case $data in */*) die "-d takes the name of a data set, POOL/data/NAME's NAME" ;; esac
	exists "$pool/data/$data" || die "no data set $pool/data/$data"
	zpool set pie:data="$pool/data/$data" "$pool" || die "cannot set the pool's data set"
fi
if [ "$target" = "$root" ]; then
	: > "$TARGET"
else
	echo "$target" > "$TARGET"
fi || die "cannot write $TARGET"
exec /usr/libexec/pie-userreboot
